# Development Dockerfile for FlameCheck.
#
# A qualitative analysis submission system for students in chemistry.
#
# Same multi-stage layout as the production Dockerfile (build the frontend,
# build the Python project with uv — including the dev dependency group), but
# the runtime uses the development settings and runs Django's autoreloading
# server. The workspace packages are installed editable pointing at /opt/...,
# matching the final image layout. The repository is typically bind-mounted
# over /opt (see docker/docker-compose.dev-full.yaml) so code edits are live;
# the frontend is built into the image at build time so the SPA is served even
# while the source is mounted.
#
# Build:
#   docker build -f docker/Dockerfile.dev -t flamecheck-dev:0.0.1 .
#   docker run -p 8000:8000 --env-file .env flamecheck-dev:0.0.1

ARG PYTHON_VERSION=3.13
ARG NODE_VERSION=22
# npm that generated frontend/package-lock.json (avoids npm/cli#4828).
ARG NPM_VERSION=11.19.0

# --- Stage 1: build the frontend -------------------------------------------
FROM node:${NODE_VERSION}-alpine AS frontend_build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install -g "npm@${NPM_VERSION}" \
 && npm ci --no-audit --no-fund \
 && (find node_modules/@rolldown -name "rolldown-binding.linux-x64-*.node" 2>/dev/null | grep -q . \
      || (echo "rolldown binding missing; clean reinstall" \
          && rm -rf node_modules package-lock.json \
          && npm install --no-audit --no-fund))
COPY frontend/ ./
RUN npm run build

# --- Stage 2: build the Python project with uv (including dev tools) -------
# The source is copied into /opt BEFORE `uv sync` so the editable installs of
# the workspace packages point at /opt/... (present in the final image too).
FROM python:${PYTHON_VERSION}-slim AS build_image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=${PYTHON_VERSION} \
    UV_PROJECT_ENVIRONMENT=/opt/.venv
ARG APT_PROXY
RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential gcc curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
# Source must be present for editable installs to reference /opt paths.
# README.md / LICENSE are read by the build backend (uv_build) when the
# project itself is built, so they must be present in this stage.
COPY src/ src/
COPY packages/ packages/
COPY pyproject.toml uv.lock README.md LICENSE ./
# The dev environment includes the dev dependency group (pytest, ruff, ...).
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --group dev
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --group dev

# --- Stage 3: final runtime image ------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS final_image
LABEL maintainer="mark doerr <mark.doerr@uni-greifswald.de>"
LABEL version="0.0.0"
LABEL description="FlameCheck - A qualitative analysis submission system for students in chemistry. (development)"

ENV LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    PROJECT_ROOT=/opt \
    UV_PROJECT_ENVIRONMENT=/opt/.venv \
    DJANGO_SETTINGS_MODULE=flamecheck.settings.development

RUN adduser --disabled-password --gecos "" appuser \
    && mkdir -p /opt/staticfiles /opt/db \
    && chown -R appuser:appuser /opt

WORKDIR /opt

# Copy the Python virtualenv + project metadata from the build stage. The
# editable .pth files inside .venv point at /opt/src and /opt/packages/...,
# which we copy next — so they resolve at runtime.
COPY --from=build_image --chown=appuser:appuser /opt/.venv /opt/.venv
COPY --chown=appuser:appuser src/ src/
COPY --chown=appuser:appuser packages/ packages/
COPY --chown=appuser:appuser manage.py pyproject.toml uv.lock ./
COPY --from=frontend_build --chown=appuser:appuser /app/dist frontend/dist
COPY --chown=appuser:appuser docker/entrypoint.dev.sh entrypoint.dev.sh
RUN chmod +x entrypoint.dev.sh

ENV PATH="/opt/.venv/bin:$PATH"
USER appuser

EXPOSE 8000

ENV DATABASE_URL=sqlite:////opt/db/db.sqlite3

# Absolute path: exec-form CMD resolves the binary against PATH, and the
# entrypoint lives in /opt (the working directory), which is not on PATH.
CMD ["/opt/entrypoint.dev.sh"]
