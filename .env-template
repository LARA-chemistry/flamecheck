# ---------------------------------------------------------------------------
# FlameCheck environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (for local development / production) and adjust:
#
#     cp .env-template .env
#
# `django-environ` reads `.env` automatically (see src/flamecheck/settings/base.py).
# For direnv, also create an `.envrc` containing `dotenv_if_exists`.
#
# Every value below has a safe default; you only need to override what you change.
# Never commit your real `.env` (it is git-ignored) — keep secrets out of VCS.
# ---------------------------------------------------------------------------

# --- Environment ------------------------------------------------------------
# "development" (default) or "production". Selects DEBUG and related defaults.
ENV=development

# --- Django -----------------------------------------------------------------
# In production you MUST set a long, random secret key.
DJANGO_SECRET_KEY=insecure-development-only-key-change-me

# Comma-separated list of hosts the server will respond to.
#   development: *        production: example.com, www.example.com
DJANGO_ALLOWED_HOSTS=*

# Optional: trusted origins for CSRF (needed for cross-origin API calls).
#DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# --- Bootstrap superuser (init_admin) --------------------------------------
# The `init_admin` command (run during `init_django` on first boot, or
# `uv run python manage.py init_admin`) creates the initial admin/superuser
# when no users exist, reading these three variables. Set a real password in
# production — the defaults below are development placeholders only.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_MAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-in-production

# --- Database ---------------------------------------------------------------
# The database BACKEND is selected entirely through DATABASE_URL — set it in
# this file (or the container environment) to switch engines; nothing else in
# the settings changes. django-environ parses the URL into Django's DATABASES
# dict, so the same code runs on any supported backend.
#
# The DEFAULT is SQLite, stored at <repo>/db.sqlite3 — no external service
# needed. Examples:
#
#   SQLite (default, relative to the repo root):
#     DATABASE_URL=sqlite:///db.sqlite3
#
#   SQLite (absolute path, note four slashes for an absolute path):
#     DATABASE_URL=sqlite:////var/lib/flamecheck/db.sqlite3
#
#   PostgreSQL (run production on Postgres — nothing else changes):
#     DATABASE_URL=postgres://flamecheck:flamecheck@db-host:5432/flamecheck
#
#   MySQL:
#     DATABASE_URL=mysql://flamecheck:flamecheck@db-host:3306/flamecheck
#
# Leave unset to use the SQLite default.
#DATABASE_URL=sqlite:///db.sqlite3

# --- JWT --------------------------------------------------------------------
# Signing key defaults to DJANGO_SECRET_KEY; set independently for rotation.
#JWT_SIGNING_KEY=change-me
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# --- Security (production) --------------------------------------------------
#DJANGO_SECURE_SSL_REDIRECT=false
#DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Application -----------------------------------------------------------
# Maximum failed logins before a username is locked out.
LOGIN_MAX_ATTEMPTS=5

# --- Docker (used by compose / justfile) -----------------------------------
# Replace "latest" with your image tag/hash.
DOCKER_IMAGE_TAG=latest

# Host port the app is published on.
#   docker-compose.yaml        (production)  -> 8000
#   docker-compose-staging.yaml (staging)    -> 8001
#   docker-compose-dev.yaml    (development) -> 8000
APP_PORT=8000

# Number of gunicorn workers (production/staging only).
GUNICORN_WORKERS=3

# Seed the demo dataset on container boot (staging only — see
# docker-compose-staging.yaml, which defaults this to true). Values:
#   true   idempotent seed (refresh without wiping)
#   reset  wipe the seeded domain first, then re-seed
#   (empty) skip seeding entirely
#SEED_DEMO=true

# Which Django settings module to run (override to switch environments).
#   production: flamecheck.settings.production   (default in the image)
#   development: flamecheck.settings.development
#DJANGO_SETTINGS_MODULE=flamecheck.settings.production

# --- PostgreSQL (optional; for the compose `db` service) -------------------
# Activate the bundled Postgres with `--profile postgres` and set DATABASE_URL
# to point at it, e.g.:
#   DATABASE_URL=postgres://flamecheck:flamecheck@db:5432/flamecheck
POSTGRES_DB=flamecheck
POSTGRES_USER=flamecheck
POSTGRES_PASSWORD=flamecheck
