# ---------------------------------------------------------------------------
# FlameCheck environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (for local development / production) and adjust:
#
#     cp .env-template .env
#
# `django-environ` reads `.env` automatically (see src/flamecheck/settings/base.py).
# For direnv, also create an `.envrc` containing `dotenv_if_exists`.
#
# Every value below has a safe default; you only need to override what you change.
# Never commit your real `.env` (it is git-ignored) — keep secrets out of VCS.
# ---------------------------------------------------------------------------

# --- Environment ------------------------------------------------------------
# "development" (default) or "production". Selects DEBUG and related defaults.
ENV=development

# --- Django -----------------------------------------------------------------
# In production you MUST set a long, random secret key.
DJANGO_SECRET_KEY=insecure-development-only-key-change-me

# Comma-separated list of hosts the server will respond to.
#   development: *        production: example.com, www.example.com
DJANGO_ALLOWED_HOSTS=*

# Optional: trusted origins for CSRF (needed for cross-origin API calls).
#DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# --- Database ---------------------------------------------------------------
# The DEFAULT is SQLite, stored at <repo>/db.sqlite3 — no external service needed.
# The engine is fully configurable through DATABASE_URL (django-environ parses it):
#
#   SQLite (default, relative to the repo root):
#     DATABASE_URL=sqlite:///db.sqlite3
#
#   SQLite (absolute path, note four slashes for an absolute path):
#     DATABASE_URL=sqlite:////var/lib/flamecheck/db.sqlite3
#
#   PostgreSQL (set this to run production on Postgres — nothing else changes):
#     DATABASE_URL=postgres://flamecheck:flamecheck@db-host:5432/flamecheck
#
# Leave unset to use the SQLite default.
#DATABASE_URL=sqlite:///db.sqlite3

# --- JWT --------------------------------------------------------------------
# Signing key defaults to DJANGO_SECRET_KEY; set independently for rotation.
#JWT_SIGNING_KEY=change-me
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# --- Security (production) --------------------------------------------------
#DJANGO_SECURE_SSL_REDIRECT=false
#DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Application -----------------------------------------------------------
# Maximum failed logins before a username is locked out.
LOGIN_MAX_ATTEMPTS=5

# --- Docker (used by compose / justfile) -----------------------------------
# Replace "latest" with your image tag/hash.
DOCKER_IMAGE_TAG=latest
